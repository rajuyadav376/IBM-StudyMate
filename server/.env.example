PORT=5000
MONGODB_URI=mongodb://localhost:27017/ibm_studymate
JWT_SECRET=ibm_studymate_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# IBM watsonx.ai credentials
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_SERVICE_URL=https://us-south.ml.cloud.ibm.com

# Model ID for IBM watsonx.ai
IBM_MODEL_ID=ibm/granite-13b-instruct-v2

# Set to "true" to use mock AI (for development without IBM credits)
USE_MOCK_AI=true

NODE_ENV=development
